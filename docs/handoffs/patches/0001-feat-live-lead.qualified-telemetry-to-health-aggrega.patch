index f65605f..5195ffb 100644
--- a/src/aion_revenue_factory/integrations/event_sink.py
+++ b/src/aion_revenue_factory/integrations/event_sink.py
@@ -68,3 +68,26 @@ class HttpTelemetrySink:
                 pass
         except Exception as exc:  # noqa: BLE001 - never break the workflow on telemetry
             self.failures.append((event.event_id, str(exc)))
+
+
+class FilteredSink:
+    """Forwards only events whose ``event_type`` is in ``event_types``."""
+
+    def __init__(self, inner: EventSink, event_types: frozenset[str]) -> None:
+        self.inner = inner
+        self.event_types = event_types
+
+    def emit(self, event: Event) -> None:
+        if event.event_type in self.event_types:
+            self.inner.emit(event)
+
+
+class CompositeSink:
+    """Fan-out sink — emits to every child without short-circuiting on failure."""
+
+    def __init__(self, sinks: List[EventSink]) -> None:
+        self.sinks = list(sinks)
+
+    def emit(self, event: Event) -> None:
+        for sink in self.sinks:
+            sink.emit(event)
diff --git a/tests/test_event_sink.py b/tests/test_event_sink.py
new file mode 100644
index 0000000..9e33778
--- /dev/null
+++ b/tests/test_event_sink.py
@@ -0,0 +1,39 @@
+"""Event sink composition for live telemetry wiring."""
+
+from aion_revenue_factory.integrations.aion_events import new_event
+from aion_revenue_factory.integrations.event_sink import (
+    CollectingSink,
+    CompositeSink,
+    FilteredSink,
+    HttpTelemetrySink,
+)
+
+
+def test_filtered_sink_forwards_matching_events_only():
+    inner = CollectingSink()
+    sink = FilteredSink(inner, frozenset({"lead.qualified"}))
+    sink.emit(new_event("lead.qualified", correlation_id="c1"))
+    sink.emit(new_event("lead.discovered", correlation_id="c1"))
+    assert inner.types() == ["lead.qualified"]
+
+
+def test_composite_sink_fans_out_to_all_children():
+    a = CollectingSink()
+    b = CollectingSink()
+    CompositeSink([a, b]).emit(new_event("lead.qualified", correlation_id="c1"))
+    assert a.types() == ["lead.qualified"]
+    assert b.types() == ["lead.qualified"]
+
+
+def test_http_telemetry_sink_records_transport_failures(monkeypatch):
+    def boom(*args, **kwargs):
+        raise OSError("network down")
+
+    monkeypatch.setattr(
+        "aion_revenue_factory.integrations.event_sink.urllib.request.urlopen",
+        boom,
+    )
+    sink = HttpTelemetrySink("https://telemetry.example/events")
+    ev = new_event("lead.qualified", correlation_id="c1")
+    sink.emit(ev)
+    assert sink.failures == [(ev.event_id, "network down")]
